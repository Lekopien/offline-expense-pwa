// Cloudflare Worker (free plan) that serves the showcase site at https://expenses.lekopien.com
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lekopien-expenses",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./app" },
  "routes": [{ "pattern": "expenses.lekopien.com", "custom_domain": true }]
}
